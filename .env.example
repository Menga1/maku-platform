# =============================================================================
# MAKU production configuration - copy to `.env` and fill in every value.
#   cp .env.example .env && nano .env
# Never commit .env (it is in .gitignore).
# =============================================================================

# --- Domain & TLS -------------------------------------------------------------
MAKU_DOMAIN=maku.ae
ACME_EMAIL=it@maku.ae

# --- Environment ----------------------------------------------------------------
# production (default in the Docker image): PostgreSQL is mandatory. Without it
# the app refuses to start; if the database goes down, every page shows an
# explicit error and nothing is saved anywhere else. Use "staging" for a test
# server with the same rules. Never use "demo"/"development" on a real server.
MAKU_ENV=production

# --- Database (local PostgreSQL container) ------------------------------------
# "localdb" starts the bundled PostgreSQL + nightly backup containers.
# Remove this line when DATABASE_URL points to a managed database.
COMPOSE_PROFILES=localdb
POSTGRES_DB=maku
POSTGRES_USER=maku
# Generate with:  openssl rand -hex 24      (hex only - no URL-special characters)
POSTGRES_PASSWORD=CHANGE_ME
# Using a managed database instead? Uncomment and set (sslmode=require recommended):
# DATABASE_URL=postgresql://user:password@your-db-host:5432/maku?sslmode=require

# --- First administrator (bootstrap account: argon2 or bcrypt, never plain text) --
# Generate the hash:  docker compose run --rm --no-deps app python manage_users.py hash
# Then wrap it in JSON. Single quotes keep the $ characters literal.
MAKU_AUTH_USERS='{"first.admin": "argon2:$argon2id$REPLACE_ME"}'
# The password must have >= 12 characters and 3 of: lowercase, uppercase,
# digits, symbols - with MAKU_ENV=production a weaker one is refused at sign-in.
# Sessions end after 30 min without activity and after 8 h in total:
# MAKU_SESSION_IDLE_MINUTES=30
# MAKU_SESSION_TIMEOUT_MINUTES=480

# --- AI briefings (optional; users must also opt in under "My account") -------
MAKU_AI_API_KEY=
MAKU_AI_MODEL=claude-sonnet-4-5
MAKU_AI_MAX_CONCURRENT_JOBS=4

# --- Privacy ---------------------------------------------------------------------
MAKU_PRIVACY_POLICY_URL=https://maku.ae/legal/privacy
MAKU_PRIVACY_POLICY_VERSION=2026-10

# --- Behaviour ---------------------------------------------------------------------
# 1 = allow sensor simulators and mock fallbacks (training/demo ONLY - shows red
# SIMULATED DATA banners). Must be 0 or empty in production.
MAKU_DEMO_MODE=0
# 1 = enable the worker heart-rate strain module. This is a HEALTH feature:
# enabling it in a store build requires the Google Play "Health apps"
# declaration and invites Apple guideline 1.4.1 review. Keep 0 for store builds.
MAKU_ENABLE_WORKER_PHYSIOLOGY=0
# 1 = show technical error details to users. Keep 0 in production.
MAKU_DEBUG=0
MAKU_SESSION_TIMEOUT_MINUTES=480

# --- Push notifications (optional, see docs/DEPLOYMENT.md section 6) -------------
# Put the Firebase service-account JSON in ./secrets/firebase-service-account.json
# (the folder is mounted read-only into the app). Leave empty to disable push.
MAKU_FCM_SERVICE_ACCOUNT_FILE=/run/maku-secrets/firebase-service-account.json
MAKU_FCM_PROJECT_ID=

# --- Backups ------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=0
