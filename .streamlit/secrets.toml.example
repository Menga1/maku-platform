# MAKU - Streamlit secrets template (safe to commit; contains no real values)
# ==========================================================================
# In the Docker deployment you normally do NOT need this file: everything is
# configured through environment variables in `.env` (see .env.example).
# Use this only for `streamlit run app.py` on a developer laptop.
#
# ONLY bcrypt credentials are accepted. Plaintext and "sha256:" values are
# REJECTED at login. Generate a value with:
#     python3 manage_users.py hash
#
# Normal staff accounts live in the database - create them in-app
# (Users (admin) page) or with `python3 manage_users.py create <name>`.
# The entries below are bootstrap administrators only.

[auth.users]
first.admin = "bcrypt:$2b$12$REPLACE_WITH_OUTPUT_OF_manage_users.py_hash"

[ai]
# Server-side Anthropic key (users then never handle a key themselves).
# api_key = "sk-ant-..."
# model = "claude-sonnet-4-5"
# web_search_max_uses = 3
