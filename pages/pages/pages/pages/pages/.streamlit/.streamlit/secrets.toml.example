# MAKU - Streamlit secrets example
# ==================================
# This file is a TEMPLATE ONLY - safe to commit to git (no real credentials
# in it). auth.py reads st.secrets["auth"]["username"]/ ["password"] at
# runtime; if those keys aren't set anywhere, auth.py silently falls back
# to a hardcoded admin/Maku2026! pair, which is NOT safe for anything
# beyond local testing before secrets are configured.
#
# Two ways to actually supply these values:
#
# 1. LOCAL DEVELOPMENT
#    Copy this file to .streamlit/secrets.toml (same folder, drop the
#    .example suffix) and fill in real values. .gitignore already excludes
#    .streamlit/secrets.toml, so it will never be committed.
#
# 2. STREAMLIT CLOUD (deployed app)
#    Do NOT upload a secrets.toml file at all. Instead:
#      - Open your app on https://share.streamlit.io
#      - Click the "..." menu (or "Manage app") -> Settings -> Secrets
#      - Paste the exact TOML content below (with your real values) into
#        the Secrets text box and click Save
#      - Streamlit Cloud injects it as st.secrets automatically - no
#        redeploy step needed beyond the save, and it's never stored in
#        your GitHub repo.

[auth]
username = "your-username-here"
password = "your-strong-password-here"
